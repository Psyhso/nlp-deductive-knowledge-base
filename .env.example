# Скопируйте в .env. Не публикуйте файл с настоящим ключом.
LLM_API_KEY=
# Укажите корень OpenAI-совместимого API, заканчивающийся на /v1.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_MAX_OUTPUT_TOKENS=6000
LLM_TIMEOUT_SECONDS=90
# json_object — совместимый JSON mode; json_schema — строгая схема;
# text — если провайдер не поддерживает response_format.
LLM_RESPONSE_FORMAT=json_object
# Для новых reasoning-моделей OpenAI может потребоваться max_completion_tokens.
LLM_TOKEN_LIMIT_PARAM=max_tokens
# Оставьте пустым, если выбранная модель не поддерживает этот параметр.
LLM_REASONING_EFFORT=
